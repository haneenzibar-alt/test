// Prisma schema for FitPlate — Saved Meals feature
// Run:
//   npx prisma migrate dev --name init_saved_meals
//   npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model User {
  id         String      @id @db.Uuid
  email      String      @unique
  name       String?
  createdAt  DateTime    @default(now())
  savedMeals SavedMeal[]

  @@map("users")
}

model Meal {
  id          String      @id @default(cuid())
  name        String
  country     String
  mealType    MealType
  calories    Int
  protein     Int
  carbs       Int
  fat         Int
  ingredients String[] // Postgres array — مدعومة مباشرة من Supabase
  allergens   String[]
  image       String
  createdAt   DateTime    @default(now())
  savedBy     SavedMeal[]

  @@map("meals")
}

// جدول وسيط (Join Table) بين المستخدم والوجبة
model SavedMeal {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  mealId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  
  @@unique([userId, mealId])
  @@map("saved_meals")
}
