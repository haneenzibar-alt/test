// Prisma schema for FitPlate — Saved Meals feature
// Run:
//   npx prisma migrate dev --name init_saved_meals
//   npx prisma generate

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  NUTRITIONIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum DietType {
  STANDARD
  VEGETARIAN
  VEGAN
  KETO
  PALEO
  MEDITERRANEAN
  PESCATARIAN
  GLUTEN_FREE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum HealthGoal {
  LOSE_WEIGHT
  MAINTAIN_WEIGHT
  GAIN_WEIGHT
}

enum MealSourcePreference {
  COOK_AT_HOME
  ORDER_DELIVERY
  EAT_OUTSIDE
  MIX_OF_ALL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  profile             Profile?
  nutritionistProfile NutritionistProfile?
  mealPlans           MealPlan[]
  dailyLogs           DailyLog[]
  aiQueries           AiRecommendation[]
  savedMeals          SavedMeal[]
  coachSessions       CoachSession[]

  // Appointments
  appointmentsAsClient       Appointment[] @relation("ClientAppointments")
  appointmentsAsNutritionist Appointment[] @relation("NutritionistAppointments")

  @@map("users")
}

model Meal {
  id          String      @id @default(cuid())
  name        String
  country     String
  mealType    MealType
  calories    Int
  protein     Int
  carbs       Int
  fat         Int
  ingredients String[]
  allergens   String[]
  image       String
  createdAt   DateTime    @default(now())
  savedBy     SavedMeal[]

  @@map("meals")
}

// جدول وسيط بين المستخدم والوجبة المحفوظة
model SavedMeal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mealId])
  @@map("saved_meals")
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String?
  age           Int?
  gender        Gender?
  height        Float?
  weight        Float?
  targetWeight  Float?
  activityLevel ActivityLevel @default(SEDENTARY)
  dietType      DietType      @default(STANDARD)
  allergies     String[]

  country                String?
  healthGoal             HealthGoal?           @default(MAINTAIN_WEIGHT)
  medicalConditions      String[]
  dislikedFoods          String[]
  mealsPerDay            Int                   @default(3)
  weeklyWorkoutFrequency Int                   @default(0)
  mealSourcePreference   MealSourcePreference? @default(COOK_AT_HOME)

  calorieTarget Int?
  proteinTarget Float?
  carbTarget    Float?
  fatTarget     Float?

  updatedAt DateTime @updatedAt
}

model NutritionistProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialty    String
  bio          String?
  credentials  String[]
  hourlyRate   Float?
  availability String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MealPlan {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime
  isAiGenerated Boolean  @default(false)

  meals MealPlanMeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MealPlanMeal {
  id         String   @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId   String
  dayOfWeek  Int
  mealType   MealType
}

model DailyLog {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                 DateTime
  waterIntake          Int      @default(0)
  weight               Float?
  activeCaloriesBurned Int      @default(0)

  mealLogs  MealLog[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, date])
}

model MealLog {
  id         String   @id @default(uuid())
  dailyLogId String
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  mealType   MealType

  customFoodName String?
  calories       Int     @default(0)
  protein        Float   @default(0)
  carbs          Float   @default(0)
  fat            Float   @default(0)
  servingSize    Float   @default(1.0)
}

model Restaurant {
  id        String               @id @default(uuid())
  name      String
  country   String?
  cuisine   String?
  address   String?
  latitude  Float?
  longitude Float?
  rating    Float?
  imageUrl  String?
  menuItems RestaurantMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantMenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  calories     Int?
  protein      Float?
  carbs        Float?
  fat          Float?
  price        Float?
}

model Appointment {
  id             String @id @default(uuid())
  clientId       String
  client         User   @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  nutritionistId String
  nutritionist   User   @relation("NutritionistAppointments", fields: [nutritionistId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  duration    Int               @default(30)
  status      AppointmentStatus @default(PENDING)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([nutritionistId])
}

model AiRecommendation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  response  Json
  createdAt DateTime @default(now())
}

model CoachSession {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  CoachMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model CoachMessage {
  id        String       @id @default(uuid())
  sessionId String
  session   CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime     @default(now())
}