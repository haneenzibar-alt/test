// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

enum Role {
  USER
  NUTRITIONIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ActivityLevel {
  SEDENTARY          // Little to no exercise
  LIGHTLY_ACTIVE     // Light exercise 1-3 days/week
  MODERATELY_ACTIVE  // Moderate exercise 3-5 days/week
  VERY_ACTIVE        // Hard exercise 6-7 days/week
  EXTRA_ACTIVE       // Very hard exercise, physical job
}

enum DietType {
  STANDARD
  VEGETARIAN
  VEGAN
  KETO
  PALEO
  MEDITERRANEAN
  PESCATARIAN
  GLUTEN_FREE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// New enums to match onboarding flow

enum HealthGoal {
  LOSE_WEIGHT
  MAINTAIN_WEIGHT
  GAIN_WEIGHT
}

enum MealSourcePreference {
  COOK_AT_HOME
  ORDER_DELIVERY
  EAT_OUTSIDE
  MIX_OF_ALL
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  passwordHash  String
  name          String?
  role          Role               @default(USER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  // Relations
  profile             UserProfile?
  nutritionistProfile NutritionistProfile?
  mealPlans           MealPlan[]
  recipes             Recipe[]           // Recipes created by user
  dailyLogs           DailyLog[]
  aiQueries           AiRecommendation[]
  savedMeals          SavedMeal[]
  coachSessions       CoachSession[]
  
  // Appointments
  appointmentsAsClient       Appointment[] @relation("ClientAppointments")
  appointmentsAsNutritionist Appointment[] @relation("NutritionistAppointments")
}

model UserProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  age            Int?
  gender         Gender?
  height         Float?        // in cm
  weight         Float?        // in kg
  targetWeight   Float?        // in kg
  activityLevel  ActivityLevel @default(SEDENTARY)
  dietType       DietType      @default(STANDARD)
  allergies      String[]      // e.g., ["nuts", "dairy"]
  
  // Onboarding fields
  country                String?               // e.g., "Lebanon" — drives cuisine recommendations
  healthGoal             HealthGoal?           @default(MAINTAIN_WEIGHT)
  medicalConditions      String[]              // e.g., ["Diabetes (Type 2)", "PCOS"]
  dislikedFoods          String[]              // e.g., ["Onions", "Cilantro"]
  mealsPerDay            Int                   @default(3)
  weeklyWorkoutFrequency Int                   @default(0) // days per week, 0-7
  mealSourcePreference   MealSourcePreference? @default(COOK_AT_HOME)
  
  // Daily Target Macros (calculated by AI or custom set)
  calorieTarget  Int?          // in kcal
  proteinTarget  Float?        // in grams
  carbTarget     Float?        // in grams
  fatTarget      Float?        // in grams
  
  updatedAt      DateTime      @updatedAt
}

model NutritionistProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  specialty    String   // e.g., "Sports Nutrition", "Keto Diet", "Weight Loss"
  bio          String?  // Professional biography
  credentials  String[] // e.g., ["Registered Dietitian (RD)", "M.S. in Nutrition"]
  hourlyRate   Float?   // Consultation rate/hour
  availability String?  // Freeform text or JSON representing schedule
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Recipe {
  id           String             @id @default(uuid())
  name         String
  description  String?
  instructions String[]           // Step-by-step instructions
  prepTime     Int?               // in minutes
  cookTime     Int?               // in minutes
  calories     Int                // per serving
  protein      Float              // in grams
  carbs        Float              // in grams
  fat          Float              // in grams
  imageUrl     String?
  country      String?            // cuisine origin, e.g. "Lebanon"
  isAiGenerated Boolean           @default(false)
  
  // Relations
  createdById  String?
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  ingredients  RecipeIngredient[]
  mealPlanMeals MealPlanMeal[]
  mealLogs     MealLog[]
  savedByUsers SavedMeal[]
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model RecipeIngredient {
  id        String   @id @default(uuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name      String   // e.g., "Greek Yogurt"
  amount    Float    // e.g., 200
  unit      String   // e.g., "g", "ml", "tbsp"
}

model MealPlan {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String         // e.g., "Keto Week 1"
  description String?
  startDate   DateTime
  endDate     DateTime
  isAiGenerated Boolean      @default(false)
  
  // Relations
  meals       MealPlanMeal[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model MealPlanMeal {
  id         String   @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 1 = Monday, 7 = Sunday
  mealType   MealType
}

model DailyLog {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime  // YYYY-MM-DD
  waterIntake        Int       @default(0) // in ml
  weight             Float?    // current weight logged on this day
  activeCaloriesBurned Int     @default(0) // workouts
  
  // Relations
  mealLogs           MealLog[]
  
  @@unique([userId, date]) // Ensure one log per user per day
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model MealLog {
  id         String    @id @default(uuid())
  dailyLogId String
  dailyLog   DailyLog  @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  mealType   MealType
  
  // A log can be linked to an existing Recipe or be a custom food item
  recipeId   String?
  recipe     Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  
  customFoodName String? // Used if logging something not in the Recipe database
  calories       Int     @default(0)
  protein        Float   @default(0)
  carbs          Float   @default(0)
  fat            Float   @default(0)
  servingSize    Float   @default(1.0) // multiplier for servings
}

// "Saved" nav section — users bookmarking meals for later
model SavedMeal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, recipeId]) // can't save the same meal twice
}

// "Restaurants" nav section
model Restaurant {
  id          String   @id @default(uuid())
  name        String
  country     String?  // e.g., "Lebanon"
  cuisine     String?  // e.g., "Lebanese", "Italian"
  address     String?
  latitude    Float?
  longitude   Float?
  rating      Float?
  imageUrl    String?
  menuItems   RestaurantMenuItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RestaurantMenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  calories     Int?
  protein      Float?
  carbs        Float?
  fat          Float?
  price        Float?
}

model Appointment {
  id             String            @id @default(uuid())
  clientId       String
  client         User              @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  nutritionistId String
  nutritionist   User              @relation("NutritionistAppointments", fields: [nutritionistId], references: [id], onDelete: Cascade)
  
  scheduledAt    DateTime          // Appointment date and time
  duration       Int               @default(30) // Duration in minutes
  status         AppointmentStatus @default(PENDING)
  notes          String?           // Notes, virtual link, or questions
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([clientId])
  @@index([nutritionistId])
}

model AiRecommendation {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt             String   // The contextual details sent to the LLM
  response           Json     // Structured recommendation outputs (meals, targets, feedback)
  createdAt          DateTime @default(now())
}

// "Nutrition Coach" (voice/chat) nav section
model CoachSession {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?        // e.g., auto-generated summary of the session
  messages  CoachMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model CoachMessage {
  id        String       @id @default(uuid())
  sessionId String
  session   CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String       // "user" or "assistant"
  content   String
  createdAt DateTime     @default(now())
}
